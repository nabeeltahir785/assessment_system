# ============================================================================
#  Assessment System — Root Environment Variables
#  Copy this file to .env and adjust values as needed.
# ============================================================================

# --- Database ---------------------------------------------------------------
DB_DATABASE=assessment_db
DB_USERNAME=assessment_user
DB_PASSWORD=assessment_pass
DB_ROOT_PASSWORD=rootpassword

# --- Port Forwarding (host ports) ------------------------------------------
# Change these if you have port conflicts on your machine.
DB_PORT_FORWARD=3307
REDIS_PORT_FORWARD=6380

# --- Frontend ---------------------------------------------------------------
BASE_URL=http://localhost:8000/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
